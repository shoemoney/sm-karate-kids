# No trailing slashes on the dep/build patterns. A trailing-slash pattern
# matches only real DIRECTORIES, so `ln -s <main>/node_modules node_modules`
# in an agent worktree is a symlink and gets staged by `git add -A`. Merging
# that branch replaces the real node_modules with a link to itself:
# "Too many levels of symbolic links", and every test exits 194.
node_modules
dist
dist-types
.tsbuild/
*.tsbuildinfo
coverage/
.remember/
test-results/
playwright-report/
blob-report/
.pending-questions.md
*.local
.env
.env.*
.DS_Store

# The product spec is kept out of the public repository.
smkk.md

# Incoming art, not ready to ship yet. The generated dojo art set IS shipped,
# and its originals are the only copy of the pre-optimization masters —
# regenerate them with tools/gen-art.sh. A negation cannot re-include anything
# under an excluded *directory*, so the parent has to be re-included first.
/assets/*
!/assets/generated/

# Workflow agent worktrees.
.claude/worktrees/
.todo-worktrees/

# Local agent loop state.
.opencode/
