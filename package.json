{
  "name": "sm-karate-kids",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --filter @smkk/game dev",
    "build": "pnpm --filter @smkk/game build",
    "preview": "pnpm --filter @smkk/game preview",
    "typecheck": "tsc -b --force && tsc -p tools/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm --filter @smkk/game exec playwright test",
    "validate:content": "tsx tools/validate-content.ts",
    "validate:assets": "tsx tools/validate-assets.ts",
    "check": "pnpm typecheck && pnpm test && pnpm validate:content && pnpm validate:assets"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
